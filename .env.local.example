# Copia este archivo a `.env.local` para pruebas locales (nunca se sube a git).
# En producción, define estas variables en el panel de Vercel (Project > Settings > Environment Variables).

# ID del spreadsheet (va en la URL de la hoja: .../spreadsheets/d/<SHEET_ID>/edit)
SHEET_ID=

# Contenido completo del JSON de la Service Account de Google Cloud, en una sola línea.
# Ejemplo:
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"mi-proyecto","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"nombre@mi-proyecto.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token",...}

# Rango de la hoja donde se insertan los datos (opcional, por defecto "BaseDatos!A:D")
# SHEET_RANGE=BaseDatos!A:D